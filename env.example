# ==========================================
# ROBO Analyzer 환경변수 설정
# ==========================================
# 이 파일을 .env로 복사하여 값을 설정하세요.
# cp env.example .env
# ==========================================

# ------------------------------------------
# 필수 설정
# ------------------------------------------

# Neo4j 데이터베이스 연결
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# LLM API 키
# 용도:
#   - 내부 테스트/배치 작업
# 주의: API 엔드포인트에서는 요청 헤더에 API 키를 필수로 전달해야 합니다.
#       - X-API-Key / OpenAI-Api-Key / Anthropic-Api-Key
# LLM_API_KEY=sk-your-api-key-here

# ------------------------------------------
# LLM 설정 (선택)
# ------------------------------------------
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1
# LLM_MAX_TOKENS=32768
# LLM_REASONING_EFFORT=medium
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DB=.llm_cache.db
# IS_CUSTOM_LLM=false
# COMPANY_NAME=

# ------------------------------------------
# 서버 설정 (선택)
# ------------------------------------------
# HOST=0.0.0.0
# PORT=5502

# ------------------------------------------
# 병렬 처리 설정 (선택)
# ------------------------------------------
# 파일 단위 병렬 처리
# FILE_CONCURRENCY=5
# 청크/배치 단위 병렬 처리 (SQL→테이블, Call LLM 등)
# MAX_CONCURRENCY=20
# SQL→테이블: true=키 단위 파이프라인(라운드 제거, 권장), false=라운드 순차
# EXP_SQL_PER_KEY_PIPELINE=true
# Step6 요약: 연결 아키텍처 컨텍스트 전체 길이 상한(문자). 0=제한 없음. 8000≈2000토큰
# EXP_STEP6_CONTEXT_MAX=8000
# DBMS 변수 분석 병렬 처리
# VARIABLE_CONCURRENCY=5

# ------------------------------------------
# 배치/토큰 제한 설정 (선택)
# ------------------------------------------
# DBMS/Framework 공통 설정
# MAX_BATCH_TOKEN=1000
# MAX_SUMMARY_CHUNK_TOKEN=5000
# STATIC_QUERY_BATCH_SIZE=40
# NEO4J_QUERY_BATCH_SIZE=30
# MAX_CONTEXT_TOKEN=500
# PARENT_EXPAND_THRESHOLD=1000

# ------------------------------------------
# 메타데이터 보강 설정 (선택)
# ------------------------------------------
# Text2SQL API 설정
# TEXT2SQL_API_URL=http://localhost:8000
#
# FK 관계 추론 설정
# FK_INFERENCE_ENABLED=true
# FK_SAMPLE_SIZE=25
# FK_SIMILARITY_THRESHOLD=0.8
# FK_MATCH_RATIO_THRESHOLD=0.8
# FK_CONCURRENCY=10

# ------------------------------------------
# 디렉토리 설정 (선택)
# ------------------------------------------
# Docker Compose 컨텍스트 (data 폴더 위치 지정)
# DOCKER_COMPOSE_CONTEXT=
#
# LLM 감사 로그 디렉토리
# LLM_AUDIT_DIR=

# ------------------------------------------
# 테스트 설정 (선택)
# ------------------------------------------
# pytest 실행 시 사용되는 테스트 설정
# Neo4j 테스트 데이터베이스 이름
# TEST_DB_NAME=test
# 테스트 출력 언어
# TEST_LOCALE=ko
# 테스트 전략 (dbms 또는 framework)
# TEST_ANALYSIS_STRATEGY=dbms
# 테스트 대상 타겟
# TEST_TARGET=postgres
# 테스트 데이터 소스 이름 (메타데이터 보강 테스트용)
# TEST_DATASOURCE_NAME=postgres_datasource

# ------------------------------------------
# DeepAgent / 관측 (로깅 최대한: LangSmith + 로컬)
# ------------------------------------------
# 로컬 JSON과 LangSmith를 함께 켜두면 로깅 최대한. 터미널은 단순 요약만(기본).
#
# LangSmith 트레이싱 (설정 시 run tree 자동 전송, 실행 후 langsmith-fetch trace <id> --format raw > trace.json)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=robo-exp-deepagent
#
# 로컬: run_dir에 stream 이벤트 JSON 기록 (tool I/O, write_todos, subagent 흐름). 기본 true 권장.
# DEEPAGENT_LOG_EVENTS=true
# 터미널에 stream 실시간 출력 (기본 false — 터미널은 단순 요약만)
# DEEPAGENT_VERBOSE=false
