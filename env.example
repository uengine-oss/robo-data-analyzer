# ==========================================
# ROBO Analyzer 환경변수 설정
# ==========================================
# 이 파일을 .env로 복사하여 값을 설정하세요.
# cp env.example .env
# ==========================================

# ------------------------------------------
# 필수 설정
# ------------------------------------------

# Neo4j 데이터베이스 연결
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=analyzer

# LLM API 키 (필수)
# LLM_API_KEY=sk-your-api-key-here

# ------------------------------------------
# LLM 설정 (선택)
# ------------------------------------------
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4
# LLM_MAX_TOKENS=128000
# LLM_REASONING_EFFORT=none
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DB=.llm_cache.db
# IS_CUSTOM_LLM=false
# COMPANY_NAME=

# ------------------------------------------
# 서버 설정 (선택)
# ------------------------------------------
# HOST=0.0.0.0
# PORT=5502

# ------------------------------------------
# 병렬 처리 설정 (선택)
# ------------------------------------------
# 파일 단위 병렬 처리 (Phase 1 AST 파싱)
# FILE_CONCURRENCY=75
# 청크/배치 단위 병렬 처리 (SQL→테이블, Call LLM 등)
# MAX_CONCURRENCY=75

# ------------------------------------------
# 배치/토큰 제한 설정 (선택)
# ------------------------------------------
# MAX_BATCH_TOKEN=2000
# MAX_SUMMARY_CHUNK_TOKEN=8000
# NEO4J_QUERY_BATCH_SIZE=30
# MAX_CONTEXT_TOKEN=500
# PARENT_EXPAND_THRESHOLD=1000

# ------------------------------------------
# DeepAgent 설정 (선택)
# ------------------------------------------
# DA_ENTITY_BATCH_SIZE=15

# ------------------------------------------
# 메타데이터 보강 설정 (선택)
# ------------------------------------------
# TEXT2SQL_API_URL=http://localhost:8000
# CATALOG_SERVICE_URL=http://localhost:5503

# ------------------------------------------
# 디렉토리 설정 (선택)
# ------------------------------------------
# Docker Compose 컨텍스트 (data 폴더 위치 지정)
# DOCKER_COMPOSE_CONTEXT=
# LLM 감사 로그 디렉토리
# LLM_AUDIT_DIR=

# ------------------------------------------
# 테스트 설정 (선택, pytest 실행 시 사용)
# ------------------------------------------
# TEST_DB_NAME=analyzer
# TEST_LOCALE=ko
# TEST_ANALYSIS_STRATEGY=framework
# TEST_TARGET=c

# ------------------------------------------
# DeepAgent / 관측 (선택)
# ------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=robo-exp-deepagent
# DEEPAGENT_LOG_EVENTS=true
# DEEPAGENT_VERBOSE=false
