# ==========================================
# ROBO Analyzer 환경변수 설정
# ==========================================
# 이 파일을 .env로 복사하여 값을 설정하세요.
# cp env.example .env
# ==========================================

# ------------------------------------------
# 필수 설정
# ------------------------------------------

# Neo4j 데이터베이스 연결
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# LLM API 키 (선택 - 내부 테스트/배치 작업용)
# 주의: 모든 API 엔드포인트에서는 요청 헤더에 API 키를 필수로 전달해야 합니다.
#       - X-API-Key
#       - OpenAI-Api-Key
#       - Anthropic-Api-Key
# 환경변수 LLM_API_KEY는 내부 테스트나 배치 작업용으로만 사용되며,
# API 엔드포인트에서는 헤더가 없으면 오류가 발생합니다.
# LLM_API_KEY=sk-your-api-key-here

# ------------------------------------------
# LLM 설정 (선택)
# ------------------------------------------
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1
# LLM_MAX_TOKENS=32768
# LLM_REASONING_EFFORT=medium
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DB=.llm_cache.db
# IS_CUSTOM_LLM=false
# COMPANY_NAME=

# ------------------------------------------
# 서버 설정 (선택)
# ------------------------------------------
# HOST=0.0.0.0
# PORT=5502

# ------------------------------------------
# 병렬 처리 설정 (선택)
# ------------------------------------------
# DBMS/Framework 공통 설정
# MAX_CONCURRENCY=5
# FILE_CONCURRENCY=5
#
# Framework 분석 세부 설정
# INHERITANCE_CONCURRENCY=5
# FIELD_CONCURRENCY=5
# METHOD_CONCURRENCY=5
#
# DBMS 분석 세부 설정
# VARIABLE_CONCURRENCY=5

# ------------------------------------------
# 배치/토큰 제한 설정 (선택)
# ------------------------------------------
# DBMS/Framework 공통 설정
# MAX_BATCH_TOKEN=1000
# MAX_SUMMARY_CHUNK_TOKEN=5000
# STATIC_QUERY_BATCH_SIZE=40
# NEO4J_QUERY_BATCH_SIZE=30
# MAX_CONTEXT_TOKEN=500
# PARENT_EXPAND_THRESHOLD=1000

# ------------------------------------------
# 메타데이터 보강 설정 (선택)
# ------------------------------------------
# Text2SQL API 설정
# TEXT2SQL_API_URL=http://localhost:8001
#
# FK 관계 추론 설정
# FK_INFERENCE_ENABLED=true
# FK_SAMPLE_SIZE=25
# FK_SIMILARITY_THRESHOLD=0.8
# FK_MATCH_RATIO_THRESHOLD=0.8

# ------------------------------------------
# 디렉토리 설정 (선택)
# ------------------------------------------
# Docker Compose 컨텍스트 (data 폴더 위치 지정)
# DOCKER_COMPOSE_CONTEXT=
#
# LLM 감사 로그 디렉토리
# LLM_AUDIT_DIR=

# ------------------------------------------
# 테스트 설정 (선택)
# ------------------------------------------
# pytest 실행 시 사용되는 테스트 설정
# Neo4j 테스트 데이터베이스 이름
# TEST_DB_NAME=test
# 테스트 출력 언어
# TEST_LOCALE=ko
# 테스트 전략 (dbms 또는 framework)
# TEST_ANALYSIS_STRATEGY=dbms
# 테스트 대상 타겟
# TEST_TARGET=postgres
