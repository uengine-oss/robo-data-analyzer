# ROBO Analyzer 환경변수 (.env.example)
# ─────────────────────────────────────────────────────────────
# 사용법: 이 파일을 ``.env`` 로 복사 후 운영 환경에 맞게 채움.
#
# 모든 변수는 ROBO_<영역>_<이름> 형식.
# 영역: LLM / CACHE / AGENT / BUDGET / NEO4J / PIPELINE / LOG / DATA
# 단위 suffix: _SECONDS / _MS / _TOKENS / _USD / _PCT / _RATIO
# 단일 진입점: shared/config/env_catalog.py

# ── LLM (yaml config 기반) ─────────────────────────────────
# 어떤 LLM config 쓸지 — llm_configs/<name>.yaml 의 <name> 명시.
# 모델 / provider / sampling / extra_body / reasoning_effort 등 모든 설정은
# 해당 yaml 안에 있음. 새 환경 추가 = yaml 1개 + 이 변수 1줄 변경.
# 자세한 가이드: llm_configs/README.md
ROBO_LLM_CONFIG=

# API key — yaml 에 박지 X (secret manager 친화). .env 가 단일 진실.
ROBO_LLM_API_KEY=

# ── 캐시 ────────────────────────────────────────────────────
# [권장] 운영기 OFF (set_llm_cache(None) 강제). 개발기만 true.
ROBO_CACHE_ENABLED=false

# ── Agent (Scan / 잔여 패턴 루프) ──────────────────────────
# [권장] 에이전트별 LLM 호출 한도 (폭주 차단).
ROBO_AGENT_SCAN_MAX_CALLS=30
ROBO_AGENT_RESIDUAL_MAX_CALLS=15
ROBO_AGENT_CONTEXT_EDITING_TRIGGER_TOKENS=80000
# Scan Agent 정규식 검증 — op_token 인식률 최소 통과선 (이하 = 정규식 폐기).
ROBO_AGENT_SCAN_REGEX_MIN_OP_RATIO=0.5

# ── 비용 차단기 ($400 사고 재발 방지) ──────────────────────
# run 당 USD 임계. 초과 시 BudgetExceededError → 자동 중단.
ROBO_BUDGET_RUN_USD=20.0

# ── Neo4j ──────────────────────────────────────────────────
ROBO_NEO4J_URI=bolt://localhost:7687
ROBO_NEO4J_USER=neo4j
ROBO_NEO4J_PASSWORD=
ROBO_NEO4J_DATABASE=neo4j
ROBO_NEO4J_UNWIND_BATCH_SIZE=2000
ROBO_NEO4J_RETRY_MAX_ATTEMPTS=5
ROBO_NEO4J_RETRY_BACKOFF_SECONDS=2.0

# ── 파이프라인 동시성 / 임계값 ─────────────────────────────
ROBO_PIPELINE_MAX_CONCURRENCY=8
ROBO_PIPELINE_FILE_CONCURRENCY=4
ROBO_PIPELINE_BIG_CONTEXT_THRESHOLD_TOKENS=1000
# 잔여 패턴 루프 — 라운드당 미해결 샘플 수 / 반복 상한.
ROBO_PIPELINE_RESIDUAL_SAMPLE_SIZE=30
ROBO_PIPELINE_RESIDUAL_MAX_ROUNDS=3
# 임베딩 step on/off — [권장] 운영 true. 테스트/디버그 시 false (모델 로드 회피).
# 모델 자체는 LLM 영역 책임 (shared/llm/embedder) — env 폐기, GPU 임베딩 서버는 LLM config 통합.
ROBO_PIPELINE_EMBED_ENABLED=true

# ── 카탈로그 ───────────────────────────────────────────────
# 외부 DB 카탈로그 연동. [권장] 운영 true.
# ON 인데 HTTP 실패 시 step raise(심각 — 조용히 skip 안 함). 자원 단위 404 만 정상.
# 분석기는 URL 호출 + 응답 처리만 — 인증/dataset 식별은 catalog 서비스 책임.
ROBO_CATALOG_ENABLED=true
ROBO_CATALOG_BASE_URL=
ROBO_CATALOG_TIMEOUT_SECONDS=120

# ── 로그 ───────────────────────────────────────────────────
ROBO_LOG_DIR=./logs
ROBO_LOG_MASK_SECRETS=true
# 파일 핸들러 on/off — 개발/테스트 true: logs/analysis.run/latest/{analyzer.log,error.log}
#   파일이 실시간 append → ``tail -f`` 로 진행/에러 추적. (옛 base_analyzer 메커니즘 복원)
# 운영기는 .env.production 에서 false 권장 → 디스크 I/O 0 / 성능 영향 0.
ROBO_LOG_FILE_ENABLED=true
# 로그 레벨 (DEBUG / INFO / WARNING / ERROR). analyzer.log 도 이 레벨 따름.
# error.log 는 file_enabled=true 일 때 항상 WARNING+ (사고 추적 전용).
ROBO_LOG_LEVEL=INFO

# ── 데이터 ─────────────────────────────────────────────────
ROBO_DATA_DIR=./data
