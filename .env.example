# ROBO Analyzer 환경변수 (.env.example)
# ─────────────────────────────────────────────────────────────
# 사용법: 이 파일을 ``.env`` 로 복사 후 운영 환경에 맞게 채움.
#
# 모든 변수는 ROBO_<영역>_<이름> 형식.
# 영역: LLM / AGENT / BUDGET / NEO4J / PIPELINE / LOG / DATA
# 단위 suffix: _SECONDS / _MS / _TOKENS / _USD / _PCT / _RATIO
# 단일 진입점: shared/config/settings.py

# ── LLM (yaml config 기반) ─────────────────────────────────
# 어떤 LLM config 쓸지 — llm/configs/<name>.yaml 의 <name> 명시.
# 모델 / provider / sampling / extra_body / reasoning_effort 등 모든 설정은
# 해당 yaml 안에 있음. 새 환경 추가 = yaml 1개 + 이 변수 1줄 변경.
# 자세한 가이드: llm/configs/README.md
ROBO_LLM_CONFIG=qwen38_sglang_local

# API key — yaml 에 박지 X (secret manager 친화). .env 가 단일 진실.
ROBO_LLM_API_KEY=
ROBO_LLM_REPETITION_GUARD=true

# 영속 응답 캐시는 기본 OFF. 모델 이름이나 endpoint만으로 같은 실행환경이라 간주하지 않는다.
# weights/revision·tokenizer·quantization·serving runtime·provider hard limit을 기록한
# content-addressed 정본의 경로와 실제 bytes SHA-256이 모두 맞을 때만 활성화된다.
ROBO_LLM_RESPONSE_CACHE=false
# 봉인된 기록 응답을 복구 replay할 때만 true. exact miss는 provider 호출 대신 실패한다.
ROBO_LLM_RESPONSE_CACHE_REQUIRE_HIT=false
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_REF=llm/capabilities/qwen38_sglang_2026_09_01.yaml
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_SHA256=aab8ef6d022b31481991cb94029043cd19521a0c9a18e7a4e0879caf593896f3
ROBO_LLM_RESPONSE_CACHE_MAX_MB=512

# ── 비용 차단기 ($400 사고 재발 방지) ──────────────────────
# run 당 USD 임계. 초과 시 BudgetExceededError → 자동 중단.
ROBO_BUDGET_RUN_USD=20.0

# ── Neo4j ──────────────────────────────────────────────────
ROBO_NEO4J_URI=bolt://localhost:7687
ROBO_NEO4J_USER=neo4j
ROBO_NEO4J_PASSWORD=
ROBO_NEO4J_DATABASE=neo4j

# ── 파이프라인 동시성 / 임계값 ─────────────────────────────
ROBO_PIPELINE_MAX_CONCURRENCY=8
ROBO_PIPELINE_LLM_MAX_CONCURRENCY=32
ROBO_PIPELINE_BATCH_MAX_TOKENS=1500
# 잔여 패턴 루프 — 라운드당 미해결 샘플 수 / 반복 상한.
# 임베딩 step on/off — [권장] 운영 true. 테스트/디버그 시 false (모델 로드 회피).
# 모델 자체는 LLM 영역 책임 (llm/client/embedder.py) — GPU 임베딩 서버는 LLM config로 통합.
ROBO_PIPELINE_EMBED_ENABLED=true

# Embedding
ROBO_EMBED_PROVIDER=sglang
ROBO_EMBED_MODEL=BAAI/bge-m3
ROBO_EMBED_API_BASE=
ROBO_EMBED_API_KEY=
ROBO_EMBED_CONCURRENCY=8
ROBO_EMBED_CHAR_BUDGET=700
ROBO_EMBED_MAX_RETRIES=6
ROBO_EMBED_TIMEOUT_SECONDS=180

# Search
ROBO_SEARCH_LLM_CONFIG=qwen38_sglang_local
ROBO_SEARCH_LLM_API_KEY=
ROBO_SEARCH_DENSE_IMPL=index
ROBO_SEARCH_FETCH_K=100
ROBO_SEARCH_ANCHOR_TOP=3
ROBO_SEARCH_SUPPORT_ROOT_TOP=12
ROBO_SEARCH_EVIDENCE_TOP=15
ROBO_SEARCH_ANCHOR_GAP=0.12
ROBO_SEARCH_SUPPORT_POLICY=graph_gated
ROBO_SEARCH_DIRECT_GAP=0.12
ROBO_SEARCH_HOP_GATE=3
ROBO_SEARCH_RANK_FLOOR=2
ROBO_SEARCH_CE_TOP=15
ROBO_SEARCH_REWRITE=novel_abbrev

# ── 카탈로그 ───────────────────────────────────────────────
# 외부 DB 카탈로그 연동. [권장] 운영 true.
# ON 인데 HTTP 실패 시 step raise(심각 — 조용히 skip 안 함). 자원 단위 404 만 정상.
# 분석기는 URL 호출 + 응답 처리만 — 인증/dataset 식별은 catalog 서비스 책임.
ROBO_CATALOG_ENABLED=true
# ★ /robo 프리픽스까지 포함해야 한다 (catalog 라우터 prefix). 비우면 샘플 보강이 skip 된다.
ROBO_CATALOG_BASE_URL=http://127.0.0.1:15503/robo
ROBO_CATALOG_TIMEOUT_SECONDS=120
ROBO_CATALOG_TEST_DATASOURCE=

# ── 로그 ───────────────────────────────────────────────────
ROBO_RUN_OUTPUT_DIR=../../_playground/analyzer/runs/live
# 파일 핸들러 on/off — 개발/테스트 true: logs/{analyzer.log,error.log}
# 별도 실행 증거가 필요할 때만 CLI --run-output으로 다른 루트를 명시한다.
#   파일이 실시간 append → ``tail -f`` 로 진행/에러 추적. (옛 base_analyzer 메커니즘 복원)
# 운영기는 .env.production 에서 false 권장 → 디스크 I/O 0 / 성능 영향 0.
ROBO_RUNTIME_EVENT_FILE_ENABLED=true
# 로그 레벨 (DEBUG / INFO / WARNING / ERROR). analyzer.log 도 이 레벨 따름.
# error.log 는 file_enabled=true 일 때 항상 WARNING+ (사고 추적 전용).
ROBO_RUNTIME_EVENT_LEVEL=INFO

# ── 데이터 ─────────────────────────────────────────────────
ROBO_DATA_DIR=./data
