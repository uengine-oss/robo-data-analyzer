# ROBO Analyzer 운영기 환경변수 (.env.production)
# ─────────────────────────────────────────────────────────────
# 운영기 정책:
# - 캐시 OFF (set_llm_cache(None) 강제)
# - reasoning 끄고 운영 (llm_configs/<name>.yaml 의 reasoning_effort: none)
# - 비용 회로 차단기 임계 명확 ($400 사고 재발 방지)
# - 비밀 마스킹 ON
#
# 비밀 (API key / password) 은 secret manager 에서 주입 (이 파일에 평문 박지 X).

# ── LLM ────────────────────────────────────────────────────
# 어떤 LLM config 쓸지 — llm_configs/<name>.yaml.
# 모델 / provider / sampling / extra_body / reasoning_effort 등 모든 설정은 yaml 안에.
ROBO_LLM_CONFIG=
# OPENAI_API_KEY (공급자별 표준 이름) 는 secret manager 에서 주입

# ── 캐시 — 운영기 강제 OFF ────────────────────────────────
ROBO_CACHE_ENABLED=false

# ── Agent 한도 (Scan / 잔여 패턴 루프) ────────────────────
ROBO_AGENT_SCAN_MAX_CALLS=30
ROBO_AGENT_RESIDUAL_MAX_CALLS=15
ROBO_AGENT_CONTEXT_EDITING_TRIGGER_TOKENS=80000

# ── 비용 회로 차단기 ──────────────────────────────────────
# run 당 USD 임계 — 운영 정책에 맞게 (보수적 20.0).
ROBO_BUDGET_RUN_USD=20.0

# ── Neo4j — 운영기 endpoint ───────────────────────────────
NEO4J_URI=
NEO4J_USER=neo4j
# NEO4J_PASSWORD 는 secret manager 에서 주입
NEO4J_DATABASE=neo4j
ROBO_NEO4J_UNWIND_BATCH_SIZE=2000
ROBO_NEO4J_RETRY_MAX_ATTEMPTS=5
ROBO_NEO4J_RETRY_BACKOFF_SECONDS=2.0

# ── 파이프라인 동시성 ─────────────────────────────────────
ROBO_PIPELINE_MAX_CONCURRENCY=8
ROBO_PIPELINE_FILE_CONCURRENCY=4
ROBO_PIPELINE_BIG_CONTEXT_THRESHOLD_TOKENS=1000
# 잔여 패턴 루프 — 라운드당 미해결 샘플 수 / 반복 상한.
ROBO_PIPELINE_RESIDUAL_SAMPLE_SIZE=30
ROBO_PIPELINE_RESIDUAL_MAX_ROUNDS=3

# ── 로그 ──────────────────────────────────────────────────
ROBO_LOG_DIR=/var/log/robo
ROBO_LOG_MASK_SECRETS=true
# 운영기 정책 — 파일 핸들러 OFF: stderr 만 (외부 로그 수집기/journald 가 흡수).
# 디스크 I/O 0 / 성능 영향 0. 디버깅 모드 켤 땐 일시적으로 true 로 전환.
ROBO_LOG_FILE_ENABLED=false
ROBO_LOG_LEVEL=INFO

# ── 데이터 ────────────────────────────────────────────────
ROBO_DATA_DIR=/var/data/robo
