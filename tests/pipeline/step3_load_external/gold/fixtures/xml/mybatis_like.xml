<?xml version="1.0" encoding="UTF-8"?>
<mapper namespace="OrderMapper">
  <select id="getOrderDetail" resultType="Order">
    SELECT * FROM orders

    <where><if test="id != null">id = #{id}</if></where>
  </select>
  <insert id="insertOrder">
    INSERT INTO orders (id) VALUES (#{id})
  </insert>
</mapper>
