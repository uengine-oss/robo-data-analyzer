{
  "file_type": "xml",
  "boundary": "delimiter",
  "delimiter": "</entity>|</view-entity>|</extend-entity>",
  "max_block_lines": 150,
  "key_patterns": [
    "^\\s*<entity\\b",
    "entity-name=\\\"[^\\\"]+\\\"",
    "table-name=\\\"[^\\\"]+\\\"",
    "^\\s*<field\\b",
    "\\bname=\\\"[^\\\"]+\\\"",
    "^\\s*<prim-key\\b",
    "^\\s*<relation\\b",
    "rel-entity-name=\\\"[^\\\"]+\\\"",
    "fk-name=\\\"[^\\\"]+\\\""
  ],
  "notes": "OFBiz entitymodel.xml 계열. <entity>...</entity>를 절대 분리하지 말고 엔티티 단위로 청크. 파일 헤더(<entitymodel>~첫 <entity>)는 첫 블록에 포함.",
  "version": 1
}
