{
  "file_type": "xml",
  "boundary": "delimiter",
  "delimiter": "</service>|</services>",
  "max_block_lines": 200,
  "key_patterns": [
    "^\\s*<service\\b",
    "name=\"[^\"]+\"",
    "invoke=\"[^\"]+\"",
    "location=\"[^\"]+\"",
    "^\\s*<attribute\\b",
    "^\\s*<auto-attributes\\b",
    "^\\s*</service>\\s*$"
  ],
  "notes": "OFBiz services.xml 형식. <service>...</service> 단위를 하나의 블록으로 유지하며, 루트 <services> 헤더/푸터는 인접 블록에 포함하거나 별도 블록으로 분리.",
  "version": 1
}
