{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillMeta",
  "description": "skills/detect_<lang>/meta.json 파일 스키마. 언어 하나의 식별 정보.",
  "type": "object",
  "required": ["language_names", "source_extensions", "import_regex"],
  "additionalProperties": true,
  "properties": {
    "$schema": {"type": "string"},
    "language_names": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "이 Skill이 담당하는 언어명 목록 (alias 포함). 예: ['C', 'Pro*C', 'ProFrame-C']."
    },
    "source_extensions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\."},
      "minItems": 1,
      "description": "소스 파일 확장자. .로 시작."
    },
    "config_patterns": {
      "type": "array",
      "items": {"type": "string"},
      "description": "설정/매니페스트 파일 glob 패턴. 예: ['**/requirements.txt','**/pyproject.toml']."
    },
    "import_regex": {
      "type": "string",
      "minLength": 1,
      "description": "import/include 행을 추출하는 정규식. 캡처 그룹 1~2개."
    },
    "vendor_info": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "typical_deployment": {"type": "string"},
        "typical_regions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
