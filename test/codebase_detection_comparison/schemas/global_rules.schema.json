{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobalRules",
  "description": "rules/ 디렉토리의 언어 무관 전역 규칙 파일들의 통합 스키마. oneOf로 5가지 파일 형식 중 하나.",
  "anyOf": [
    {"$ref": "#/definitions/ExtLang"},
    {"$ref": "#/definitions/KnownPrefixes"},
    {"$ref": "#/definitions/KnownProprietary"},
    {"$ref": "#/definitions/BuildMarkers"},
    {"$ref": "#/definitions/Thresholds"}
  ],
  "definitions": {
    "ExtLang": {
      "description": "ext_lang.json: 확장자→언어 매핑.",
      "type": "object",
      "additionalProperties": {"type": "string"},
      "examples": [{".py": "Python", ".c": "C"}]
    },
    "KnownPrefixes": {
      "description": "known_prefixes.json: 언어별 표준 라이브러리 화이트리스트.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "KnownProprietary": {
      "description": "known_proprietary.json: prefix → 독점 프레임워크 힌트.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "BuildMarkers": {
      "description": "build_markers.json: 마커파일명 → 빌드시스템 이름.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "Thresholds": {
      "description": "thresholds.json: 네거티브 매칭 및 confidence 임계값.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "negative_matcher": {
          "type": "object",
          "properties": {
            "score_min": {"type": "integer", "minimum": 1},
            "proprietary_score": {"type": "integer", "minimum": 1},
            "proprietary_file_count": {"type": "integer", "minimum": 1},
            "max_results": {"type": "integer", "minimum": 1}
          }
        },
        "scoring": {
          "type": "object",
          "properties": {
            "sigmoid_k": {"type": "number"},
            "min_confidence_to_report": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        }
      }
    }
  }
}
