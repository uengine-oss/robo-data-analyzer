{
  "$schema": "../../schemas/skill_meta.schema.json",
  "language_names": ["TypeScript", "JavaScript"],
  "source_extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
  "config_patterns": [
    "**/package.json",
    "**/tsconfig.json",
    "**/.env",
    "**/.env.*",
    "**/schema.prisma",
    "**/docker-compose.yml",
    "**/next.config.js",
    "**/next.config.mjs",
    "**/nest-cli.json"
  ],
  "import_regex": "(?:from\\s+[\\'\"]([^\\'\"]+)[\\'\"]|require\\s*\\(\\s*[\\'\"]([^\\'\"]+)[\\'\"])",
  "vendor_info": {
    "typical_deployment": "container"
  }
}
