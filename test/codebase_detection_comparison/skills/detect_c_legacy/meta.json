{
  "$schema": "../../schemas/skill_meta.schema.json",
  "language_names": ["C", "Pro*C", "ProFrame-C", "COBOL"],
  "source_extensions": [".c", ".h", ".ec", ".pc", ".cbl", ".cob"],
  "config_patterns": [
    "**/Makefile",
    "**/makefile",
    "**/*.mk",
    "**/*.mak",
    "**/CMakeLists.txt"
  ],
  "import_regex": "^\\s*#include\\s*[<\"]([^>\"]+)[>\"]",
  "vendor_info": {
    "typical_deployment": "on-premise",
    "typical_regions": ["Korea", "Japan"]
  }
}
